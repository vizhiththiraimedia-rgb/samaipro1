# Terra Classic Network settings
# columbus-5 is the mainnet chain ID for Terra Classic
LUNC_CHAIN_ID=columbus-5
LUNC_LCD_URL=https://columbus-lcd.terra.dev

# Validator operator address to delegate to (e.g. terravaloper1...)
VALIDATOR_ADDRESS=terravaloper1...

# Seed phrase (24 words) of the LUNC wallet that owns the delegated funds
LUNC_MNEMONIC="your twenty four word seed phrase goes here exactly as provided by station wallet"

# Reserve setting: minimum LUNC to keep in wallet for gas fees (100 LUNC = 100,000,000 uluna)
GAS_RESERVE_LUNA=100000000
